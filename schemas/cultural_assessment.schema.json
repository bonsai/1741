{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/1919/blob/main/schemas/cultural_assessment.schema.json",
  "title": "Cultural Ecosystem Assessment",
  "description": "文化資源・ステークホルダー・地域に関する評価記録。評価単位と根拠を明示し、未確認をゼロ点扱いしない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "subject_type", "subject_id", "dimension", "assessment_status", "source_ids"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["cultural_resource", "stakeholder", "region", "relationship", "activity"]},
    "subject_id": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["ecosystem", "preservation", "support", "tourism", "development", "education", "participation", "documentation", "other"]},
    "assessment_status": {"enum": ["confirmed", "partially_confirmed", "not_confirmed", "not_surveyed", "needs_inquiry"]},
    "score": {"type": ["number", "null"], "minimum": 0},
    "score_scale": {"type": ["string", "null"]},
    "finding": {"type": ["string", "null"]},
    "evidence_summary": {"type": ["string", "null"]},
    "assessed_at": {"type": ["string", "null"], "format": "date"},
    "valid_period": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  }
}