{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/1919/blob/main/schemas/cultural_relation.schema.json",
  "title": "Cultural Ecosystem Relation",
  "description": "ステークホルダー・文化資源・地域の関係。多対多を許容し、役割と根拠を記録する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["relation_id", "stakeholder_id", "resource_id", "relation_roles", "verification_status", "source_ids"],
  "properties": {
    "relation_id": {"type": "string", "minLength": 1},
    "stakeholder_id": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "region_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relation_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["origin_area", "transmission_area", "preservation", "performance", "event_host", "funding", "administration", "education", "research", "documentation", "tourism_promotion", "commercial_use", "publicity", "participation", "venue_provision", "other"]}},
    "activity_description": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "verification_status": {"enum": ["verified", "partially_verified", "unverified", "needs_review"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  }
}