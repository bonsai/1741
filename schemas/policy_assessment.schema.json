{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/1919/blob/main/schemas/policy_assessment.schema.json",
  "title": "Cultural Policy Assessment",
  "description": "行政主体の文化政策・事業・実施・成果の評価記録。地域の文化活動そのものと行政の寄与を区別する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "administrative_subject_id", "policy_domain", "logic_stage", "assessment_status", "source_ids"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "administrative_subject_id": {"type": "string", "minLength": 1},
    "policy_or_program_id": {"type": ["string", "null"]},
    "policy_domain": {"enum": ["governance", "resources", "heritage", "access", "creation", "tourism", "digital", "collaboration", "evaluation", "other"]},
    "logic_stage": {"enum": ["input", "activity", "output", "outcome", "impact", "mixed"]},
    "assessment_status": {"enum": ["confirmed", "partially_confirmed", "not_confirmed", "not_surveyed", "not_public", "not_applicable", "needs_inquiry"]},
    "value": {"type": ["number", "string", "boolean", "null"]},
    "unit": {"type": ["string", "null"]},
    "score": {"type": ["number", "null"], "minimum": 0},
    "score_scale": {"type": ["string", "null"]},
    "finding": {"type": ["string", "null"]},
    "administrative_contribution": {"type": ["string", "null"]},
    "target_period_start": {"type": ["string", "null"], "format": "date"},
    "target_period_end": {"type": ["string", "null"], "format": "date"},
    "assessed_at": {"type": ["string", "null"], "format": "date"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "method_notes": {"type": ["string", "null"]},
    "limitations": {"type": ["string", "null"]}
  }
}