{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/1919/blob/main/schemas/cultural_activity.schema.json",
  "title": "Cultural Activity",
  "description": "文化資源の保存・継承・教育・観光活用・発信等の具体的活動。",
  "type": "object",
  "additionalProperties": false,
  "required": ["activity_id", "resource_id", "activity_type", "title", "status", "source_ids"],
  "properties": {
    "activity_id": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "lead_stakeholder_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "participating_stakeholder_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "region_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "activity_type": {"enum": ["preservation", "successor_training", "performance", "festival", "school_education", "community_learning", "documentation", "archive", "tourism_program", "visitor_experience", "travel_product", "international_promotion", "digital_promotion", "research", "other"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "start_date": {"type": ["string", "null"], "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "status": {"enum": ["ongoing", "completed", "planned", "cancelled", "unknown"]},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  }
}