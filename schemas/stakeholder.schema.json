{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bonsai/1919/blob/main/schemas/stakeholder.schema.json",
  "title": "Cultural Stakeholder",
  "description": "地域文化に関わる多様な主体。自治体は主体の一類型として扱い、特別な中心性を与えない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["stakeholder_id", "name", "stakeholder_types", "record_status", "source_ids"],
  "properties": {
    "stakeholder_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "stakeholder_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["municipality", "prefecture", "preservation_group", "performer", "individual_practitioner", "resident_group", "school", "university", "researcher", "museum", "tourism_association", "travel_business", "company", "npo", "media", "foundation", "government_agency", "other"]}},
    "parent_stakeholder_id": {"type": ["string", "null"]},
    "official_url": {"type": ["string", "null"], "format": "uri"},
    "location_region_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "record_status": {"enum": ["active", "inactive", "unknown", "needs_review"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  }
}